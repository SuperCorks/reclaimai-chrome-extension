{
  "manifest_version": 3,
  "name": "Reclaim Planner Duration Helper",
  "version": "0.1.0",
  "description": "Appends durations to time ranges on app.reclaim.ai/planner.",
  "content_scripts": [
    {
      "matches": [
        "https://app.reclaim.ai/planner*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
